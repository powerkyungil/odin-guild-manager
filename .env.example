# Copy this file to .env and enter your local secrets. Never commit .env.
JWT_SECRET=replace-with-a-long-random-value
PORT=3000
CLOVA_OCR_INVOKE_URL=https://your-api-gateway-url/infer
CLOVA_OCR_SECRET=your-clova-ocr-secret
CLOVA_OCR_TEMPLATE_ID=your-template-id
# Comma-separated display name and template ID pairs used by the app selector.
CLOVA_OCR_TEMPLATES=본섭:12345,침공:67890
